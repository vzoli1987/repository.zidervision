<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.napiszex" name="Napiszex" version="1.0.0" provider-name="ZiDERViSiON">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.resolveurl" version="5.0.0"/>
        <import addon="script.module.requests" version="2.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">Napiszex Video Addon</summary>
        <description lang="en">Browse and watch videos from napiszex.com using ResolveURL.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>