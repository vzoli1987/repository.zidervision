<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.mafab" name="Mafab.hu" version="0.8.2" provider-name="ZiDER ViSiON">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
    <import addon="script.module.requests" version="2.27.0"/>
    <import addon="script.module.beautifulsoup4" version="4.8.0"/>
    <import addon="script.module.resolveurl" version="5.1.0" optional="true"/>
    <import addon="script.module.zidervisionurlresolver" version="1.0.0" optional="true"/>
    <import addon="plugin.video.youtube" optional="true"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="hu_HU">Mafab.hu filmadatbázis: előzetesek, filmlisták, keresés</summary>
    <summary lang="en_GB">Mafab.hu movie database: trailers, movie lists, search</summary>
    <description lang="hu_HU">A Mafab.hu magyar filmadatbázis böngészése Kodiból: előzetesek és videók, legjobb filmek és sorozatok, új adatlapok, keresés. Nem hivatalos kiegészítő.</description>
    <description lang="en_GB">Browse the Hungarian Mafab.hu movie database from Kodi: trailers and videos, best movies and series, new entries, search. Unofficial add-on.</description>
    <platform>all</platform>
    <license>GPL-3.0-or-later</license>
    <language>hu en</language>
  </extension>
</addon>
