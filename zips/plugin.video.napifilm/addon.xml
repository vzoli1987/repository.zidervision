<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.napifilm"
       name="NapiFilm"
       version="1.0.2"
       provider-name="ZiderVision">

    <requires>
        <import addon="xbmc.python" version="3.0.0" />
        <import addon="script.module.zidervisionurlresolver" version="1.0.1" />
        <import addon="script.module.resolveurl" version="5.1.0" optional="true" />
    </requires>

    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>

    <extension point="xbmc.addon.metadata">
        <summary lang="hu_HU">NapiFilm katalógus és engedélyezett videólejátszás</summary>
        <summary lang="en_GB">NapiFilm catalogue and authorized video playback</summary>

        <description lang="hu_HU">A NapiFilm nyilvános katalógusának böngészése. A lejátszás kizárólag engedélyezett forrásokkal használható.</description>
        <description lang="en_GB">Browse the public NapiFilm catalogue. Playback must only be used with authorized sources.</description>

        <platform>all</platform>
        <license>GPL-3.0-or-later</license>

        <assets>
            <icon>resources/icon.png</icon>
        </assets>
    </extension>
</addon>