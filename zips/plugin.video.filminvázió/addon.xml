<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.filminvázió" name="Filminvázió" version="1.0.0" provider-name="ZiDER ViSiON">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
        <import addon="script.module.resolveurl" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="hu">Filminvázió katalógus és online lejátszás</summary>
        <description lang="hu">Kodi 21.3 kiegészítő a Filminvázió katalógusának böngészéséhez. Tartalmaz kategória- és év szerinti böngészést, keresést, mentett kereséseket, gyorsítótárat, ResolveURL-alapú lejátszást és beküldött videóforrásokat.</description>
        <language>hu</language>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart></fanart>
        </assets>
        <license>GPL-3.0-only</license>
        <website>https://filminvázió.pro/</website>
        <source>https://filminvázió.pro/</source>
    </extension>
</addon>
